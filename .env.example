# =============================================================================
# Monitoring Karyawan Activity — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=monitoring_user
POSTGRES_PASSWORD=monitoring_secret_2026
POSTGRES_DB=monitoring_db
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ─── Backend ───────────────────────────────────────────────────────────────────
APP_NAME="Monitoring Karyawan Activity"
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-this-to-a-random-secret-key-in-production
APP_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── JWT / Auth ────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_SESSIONS_PER_USER=3

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# ─── Docker ────────────────────────────────────────────────────────────────────
POSTGRES_DATA_VOLUME=postgres_data
REDIS_DATA_VOLUME=redis_data
