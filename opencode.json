{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "general",
  "agent": {
    "planner":  { "model": "opencode/big-pickle", "mode": "primary",   "description": "Perencana dan arsitek. PRD, TRD, sprint planning." },
    "builder":  { "model": "opencode/big-pickle", "mode": "subagent",  "description": "Developer. Implementasi kode, testing." },
    "reviewer": { "model": "opencode/big-pickle", "mode": "subagent",  "description": "Code reviewer. Review kode, quality gate." },
    "devops":   { "model": "opencode/big-pickle", "mode": "subagent",  "description": "DevOps. Deploy, CI/CD, infra." },
    "memory":   { "model": "opencode/big-pickle", "mode": "subagent",  "description": "Memory keeper. Persistent context, decision log." },
    "clickup":  { "model": "opencode/big-pickle", "mode": "subagent",  "description": "ClickUp specialist. Tasks, docs, sprint via MCP." },
    "orchestrator": { "model": "opencode/big-pickle", "mode": "primary",   "description": "Pipeline orchestrator. Koordinator PRD→TRD→Sprint→Tasks." },
    "general":  { "model": "opencode/big-pickle", "mode": "primary",   "description": "Router umum. Menjawab pertanyaan, mendelegasikan ke agent specialist." }
  },
  "command": {},
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}" }
    },
    "clickup": {
      "type": "local",
      "command": ["npx", "-y", "clickup-mcp-pro"],
      "enabled": true,
      "env": {
        "CLICKUP_API_TOKEN": "{env:CLICKUP_API_TOKEN}",
        "CLICKUP_FOLDER_ID": "{env:CLICKUP_FOLDER_ID}"
      }
    }
  },
  "permission": {
    "edit": "ask",
    "bash": { "git *": "allow", "npm *": "allow", "npx *": "allow", "node *": "allow", "ls *": "allow", "mkdir *": "allow", "*": "ask" }
  },
  "instructions": ["AGENTS.md", "docs/CLICKUP.md"],
  "formatter": true,
  "lsp": true
}
