{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "planner",
  "logLevel": "INFO",
  "share": "manual",
  "autoupdate": true,
  "snapshot": true,
  "instructions": ["AGENTS.md", "docs/STANDARDS.md", "docs/WORKFLOW.md"],
  "skills": {
    "paths": [".opencode/skills", ".opencode/workflow-skills", ".opencode/design-skills"]
  },
  "references": {
    "docs": { "path": "docs", "description": "Dokumentasi proyek" },
    "api-spec": { "path": "docs/api", "description": "Spesifikasi API" },
    "db-schema": { "path": "docs/database", "description": "Skema database" }
  },
  "agent": {
    "planner": { "model": "anthropic/claude-sonnet-4-6", "mode": "primary", "description": "Perencana dan arsitek. PRD, technical requirements, arsitektur." },
    "builder": { "model": "anthropic/claude-sonnet-4-6", "mode": "subagent", "description": "Developer utama. Implementasi kode, testing, debugging." },
    "reviewer": { "model": "anthropic/claude-sonnet-4-6", "mode": "subagent", "description": "Code reviewer. Review kode, kualitas, standar." },
    "devops": { "model": "anthropic/claude-sonnet-4-6", "mode": "subagent", "description": "DevOps. CI/CD, deployment, monitoring, infrastruktur." },
    "designer": { "model": "anthropic/claude-sonnet-4-6", "mode": "subagent", "description": "UI/UX designer. Desain antarmuka, prototyping." },
    "analyst": { "model": "anthropic/claude-sonnet-4-6", "mode": "subagent", "description": "Business analyst. Analisis kebutuhan, data, riset." },
    "tester": { "model": "anthropic/claude-sonnet-4-6", "mode": "subagent", "description": "QA engineer. Testing, quality assurance." },
    "documenter": { "model": "anthropic/claude-sonnet-4-6", "mode": "subagent", "description": "Technical writer. Dokumentasi teknis, API docs." },
    "security": { "model": "anthropic/claude-sonnet-4-6", "mode": "subagent", "description": "Security analyst. Audit keamanan, vulnerability." },
    "dba": { "model": "anthropic/claude-sonnet-4-6", "mode": "subagent", "description": "DBA. Desain skema, optimasi query, migrasi." }
  },
  "command": {},
  "mcp": {},
  "plugin": [],
  "permission": {
    "edit": "ask",
    "bash": { "git *": "allow", "npm *": "allow", "npx *": "allow", "node *": "allow", "python *": "allow", "docker *": "allow", "ls *": "allow", "mkdir *": "allow", "*": "ask" },
    "external_directory": { "~/projects/**": "allow", "~/.config/**": "allow", "*": "ask" }
  },
  "formatter": true,
  "lsp": true,
  "experimental": { "primary_tools": ["edit", "glob", "grep", "bash", "task"], "mcp_timeout": 30000 },
  "tool_output": { "max_lines": 300, "max_bytes": 16384 },
  "compaction": { "auto": true, "tail_turns": 20 }
}
